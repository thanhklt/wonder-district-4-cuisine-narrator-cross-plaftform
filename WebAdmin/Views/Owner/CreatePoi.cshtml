@{
    Layout = "_OwnerLayout";
    ViewData["Title"] = "Tạo POI mới";
}

<!-- Owner: Create / Edit POI -->
<div id="view-create-poi" class="view-section active">
    <div class="section-header">
        <div>
            <h3 class="section-title" id="create-poi-title">Tạo POI mới</h3>
            <p class="section-subtitle">Nhập thông tin điểm tham quan âm thanh</p>
        </div>
    </div>

    <div class="glass-card" style="padding:24px; max-width:800px;">
        <div class="poi-form-grid">
            <div>
                <label class="form-label">Tên POI *</label>
                <input type="text" id="poi-name" class="form-input" placeholder="VD: Phở Hòa Pasteur">
            </div>
            <div>
                <label class="form-label">Gói đăng ký *</label>
                <select id="poi-package" class="form-input">
                    <option value="">-- Đang tải gói... --</option>
                </select>
            </div>
            <!-- Ảnh: 2 section song song -->
            <div class="full-width" style="display:grid;grid-template-columns:1fr 1fr;gap:16px;">
                <!-- Ảnh bìa -->
                <div style="background:var(--surface-2,#1e1e2e);border:1px solid var(--border);border-radius:10px;padding:16px;">
                    <label class="form-label" style="display:flex;align-items:center;gap:6px;">
                        <i class="fa-solid fa-star" style="color:#f59e0b;font-size:12px;"></i> Ảnh bìa <span style="color:#ef4444;">*</span>
                    </label>
                    <input type="file" id="poi-image" class="form-input" accept="image/*"
                           style="margin-bottom:8px;" onchange="previewCoverImage(this)">
                    <input type="url" id="poi-image-url" class="form-input"
                           placeholder="Hoặc nhập URL ảnh bìa..." style="margin-bottom:8px;">
                    <div id="cover-preview" style="display:none;margin-top:8px;">
                        <img id="cover-preview-img" style="width:100%;height:120px;object-fit:cover;border-radius:6px;" alt="">
                    </div>
                </div>
                <!-- Ảnh bổ sung -->
                <div style="background:var(--surface-2,#1e1e2e);border:1px solid var(--border);border-radius:10px;padding:16px;">
                    <label class="form-label">Ảnh bổ sung (tối đa 3)</label>
                    <div style="display:flex;flex-direction:column;gap:8px;">
                        <input type="file" id="poi-extra-1" class="form-input" accept="image/*"
                               onchange="previewExtra(this,'extra-prev-1')">
                        <img id="extra-prev-1" style="display:none;width:100%;height:60px;object-fit:cover;border-radius:4px;" alt="">
                        <input type="file" id="poi-extra-2" class="form-input" accept="image/*"
                               onchange="previewExtra(this,'extra-prev-2')">
                        <img id="extra-prev-2" style="display:none;width:100%;height:60px;object-fit:cover;border-radius:4px;" alt="">
                        <input type="file" id="poi-extra-3" class="form-input" accept="image/*"
                               onchange="previewExtra(this,'extra-prev-3')">
                        <img id="extra-prev-3" style="display:none;width:100%;height:60px;object-fit:cover;border-radius:4px;" alt="">
                    </div>
                </div>
            </div>
            <div class="full-width">
                <label class="form-label">Mô tả</label>
                <textarea id="poi-description" class="form-input" rows="4" placeholder="Mô tả chi tiết về điểm tham quan..."></textarea>
            </div>
            <div>
                <label class="form-label">Vĩ độ (Latitude)</label>
                <input type="number" step="0.000001" id="poi-lat" class="form-input mono" placeholder="10.7845">
            </div>
            <div>
                <label class="form-label">Kinh độ (Longitude)</label>
                <input type="number" step="0.000001" id="poi-lng" class="form-input mono" placeholder="106.6912">
            </div>
        </div>

        <div style="display:flex; gap:12px; justify-content:flex-end; margin-top:24px; padding-top:20px; border-top:1px solid var(--border);">
            <a href="/owner/pois" class="btn-ghost" style="text-decoration:none;">
                <i class="fa-solid fa-arrow-left"></i> Quay lại
            </a>
            <button class="btn-ghost btn-ripple" id="btn-save-poi">
                <i class="fa-solid fa-floppy-disk"></i> Lưu nháp
            </button>
            <button class="btn-primary btn-ripple" id="btn-save-and-submit-poi">
                <i class="fa-solid fa-paper-plane"></i> Lưu & Gửi duyệt
            </button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function previewCoverImage(input) {
            var prev = document.getElementById('cover-preview');
            var img = document.getElementById('cover-preview-img');
            if (input.files && input.files[0]) {
                img.src = URL.createObjectURL(input.files[0]);
                prev.style.display = 'block';
            }
        }
        function previewExtra(input, previewId) {
            var img = document.getElementById(previewId);
            if (input.files && input.files[0]) {
                img.src = URL.createObjectURL(input.files[0]);
                img.style.display = 'block';
            }
        }
        document.addEventListener('DOMContentLoaded', function () {
            if (window.AudioTravelling && AudioTravelling.Modules && AudioTravelling.Modules.initCreatePOI) {
                AudioTravelling.Modules.initCreatePOI();
            }
        });
    </script>
}
