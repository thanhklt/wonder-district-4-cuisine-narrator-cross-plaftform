@{
    Layout = "_OwnerLayout";
    ViewData["Title"] = "Quản lý POI";
}

<!-- Owner: My POIs -->
<div id="view-my-pois" class="view-section active">
    <div class="section-header">
        <div>
            <h3 class="section-title">Quản lý POI</h3>
            <p class="section-subtitle">Quản lý các điểm tham quan âm thanh của bạn</p>
        </div>
        <a href="/owner/pois/create" class="btn-primary btn-ripple" style="text-decoration:none;">
            <i class="fa-solid fa-plus"></i> Tạo POI mới
        </a>
    </div>

    <div class="glass-card" style="padding:24px;">
        <table class="admin-table">
            <thead>
                <tr>
                    <th style="padding:16px 24px;">Mã</th>
                    <th style="padding:16px 24px;">Tên POI</th>
                    <th style="padding:16px 24px;">Trạng thái</th>
                    <th style="padding:16px 24px;">Cập nhật</th>
                    <th style="padding:16px 24px;text-align:center;">Hành động</th>
                </tr>
            </thead>
            <tbody id="my-pois-body">
                <!-- Injected by JS -->
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            if (window.AudioTravelling && AudioTravelling.Modules && AudioTravelling.Modules.initMyPOIs) {
                AudioTravelling.Modules.initMyPOIs();
            }
        });
    </script>
}
