@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Thống kê truy cập";
}

<!-- Admin: Access Sessions -->
<div id="view-access-history" class="view-section active">
    <div class="section-header">
        <div>
            <h3 class="section-title">Quản lý phiên truy cập</h3>
            <p class="section-subtitle">Danh sách các phiên truy cập hệ thống qua mã QR</p>
        </div>
        <span style="font-size:13px; color:var(--text-dim);" id="history-count">0 bản ghi</span>
    </div>

    <!-- Filters -->
    <div class="filter-controls" style="gap:12px; flex-wrap:wrap;">
        <div style="display:flex; align-items:center; gap:8px;">
            <label class="form-label" style="margin:0; white-space:nowrap;">Từ ngày</label>
            <input type="date" id="filter-history-from" class="form-input" style="width:155px; padding:8px 10px;">
        </div>
        <div style="display:flex; align-items:center; gap:8px;">
            <label class="form-label" style="margin:0; white-space:nowrap;">Đến ngày</label>
            <input type="date" id="filter-history-to" class="form-input" style="width:155px; padding:8px 10px;">
        </div>
        <select id="filter-history-status" class="form-input" style="width:160px; padding:8px 10px;">
            <option value="all">Tất cả trạng thái</option>
            <option value="active">Hoạt động</option>
            <option value="expired">Hết hạn</option>
        </select>
        <button class="btn-primary" id="btn-filter-history" style="font-size:13px; padding:8px 18px;">
            <i class="fa-solid fa-filter"></i> Lọc
        </button>
        <button class="btn-ghost" id="btn-reset-history" style="font-size:13px; padding:8px 14px;">
            <i class="fa-solid fa-rotate-left"></i> Đặt lại
        </button>
    </div>

    <div class="glass-card" style="padding:24px; overflow-x:auto;">
        <table class="admin-table" style="min-width:800px;">
            <thead>
                <tr>
                    <th>Session ID</th>
                    <th>Device ID</th>
                    <th>Mã QR</th>
                    <th>Ngày quét</th>
                    <th>Hết hạn</th>
                    <th style="text-align:center;">Trạng thái</th>
                </tr>
            </thead>
            <tbody id="access-history-body">
                <!-- Injected by JS -->
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            if (window.AudioTravelling && AudioTravelling.Modules) {
                if (AudioTravelling.Modules.initAccessHistory) {
                    AudioTravelling.Modules.initAccessHistory();
                }
            }
        });
    </script>
}
