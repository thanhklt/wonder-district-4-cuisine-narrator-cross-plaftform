@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Tổng quan";
}

<!-- Admin Dashboard -->
<div id="view-dashboard-admin" class="view-section active">

    <!-- Stats Row -->
    <div class="grid-4 mb-6">
        <div class="glass-card stat-card-admin">
            <div class="stat-icon green"><i class="fa-solid fa-users"></i></div>
            <p class="stat-label">Người dùng đang hoạt động</p>
            <p class="stat-value" id="stat-active-users">0</p>
        </div>
        <div class="glass-card stat-card-admin">
            <div class="stat-icon red"><i class="fa-solid fa-ban"></i></div>
            <p class="stat-label">POI bị từ chối</p>
            <p class="stat-value" id="stat-total-scans">0</p>
        </div>
        <div class="glass-card stat-card-admin">
            <div class="stat-icon purple"><i class="fa-solid fa-map-pin"></i></div>
            <p class="stat-label">Tổng số POI đã duyệt</p>
            <p class="stat-value" id="stat-total-pois">0</p>
        </div>
        <div class="glass-card stat-card-admin">
            <div class="stat-icon amber"><i class="fa-solid fa-hourglass-half"></i></div>
            <p class="stat-label">POI chờ duyệt</p>
            <p class="stat-value" id="stat-pending-pois">0</p>
        </div>
    </div>

    <!-- Heatmap Section -->
    <div class="section-header" style="margin-top:8px;">
        <div>
            <h3 class="section-title">Heatmap khu vực</h3>
            <p class="section-subtitle">Bản đồ nhiệt thể hiện mật độ truy cập và quét QR theo khu vực</p>
        </div>
    </div>

    <div class="glass-card" style="padding:24px;">
        <div id="heatmap-container"></div>
        <div id="heatmap-empty-state" class="hidden" style="text-align:center;padding:40px;color:var(--text-dim);">
            <i class="fa-solid fa-map" style="font-size:32px;margin-bottom:12px;display:block;"></i>
            Chưa có dữ liệu heatmap
        </div>
        <div style="display:flex; gap:24px; margin-top:16px; font-size:12px; color:var(--text-dim);">
            <div style="display:flex; align-items:center; gap:6px;">
                <div style="width:12px; height:12px; border-radius:3px; background:#22c55e;"></div> Thấp
            </div>
            <div style="display:flex; align-items:center; gap:6px;">
                <div style="width:12px; height:12px; border-radius:3px; background:#fbbf24;"></div> Trung bình
            </div>
            <div style="display:flex; align-items:center; gap:6px;">
                <div style="width:12px; height:12px; border-radius:3px; background:#ef4444;"></div> Cao
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            if (window.AudioTravelling && AudioTravelling.Modules && AudioTravelling.Modules.initAdminDashboard) {
                AudioTravelling.Modules.initAdminDashboard();
            }
        });
    </script>
}
