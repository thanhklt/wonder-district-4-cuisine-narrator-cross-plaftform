@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Tổng quan";
}

<!-- Admin Dashboard -->
<div id="view-dashboard-admin" class="view-section active">

    <!-- Stats Row -->
    <div class="grid-4 mb-6">
        <div class="glass-card stat-card-admin">
            <div class="stat-icon green"><i class="fa-solid fa-users"></i></div>
            <p class="stat-label">Người dùng đang hoạt động</p>
            <p class="stat-value" id="stat-active-users">0</p>
        </div>
        <div class="glass-card stat-card-admin">
            <div class="stat-icon red"><i class="fa-solid fa-ban"></i></div>
            <p class="stat-label">POI bị từ chối</p>
            <p class="stat-value" id="stat-total-scans">0</p>
        </div>
        <div class="glass-card stat-card-admin">
            <div class="stat-icon purple"><i class="fa-solid fa-map-pin"></i></div>
            <p class="stat-label">Tổng số POI đã duyệt</p>
            <p class="stat-value" id="stat-total-pois">0</p>
        </div>
        <div class="glass-card stat-card-admin">
            <div class="stat-icon amber"><i class="fa-solid fa-hourglass-half"></i></div>
            <p class="stat-label">POI chờ duyệt</p>
            <p class="stat-value" id="stat-pending-pois">0</p>
        </div>
    </div>

    <!-- Line chart: lượt quét QR 7 ngày gần nhất -->
    <div class="glass-card" style="padding:24px;">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:20px;">
            <div>
                <h3 style="font-size:16px; font-weight:700; margin:0;">Lượt quét QR theo ngày</h3>
                <p style="font-size:13px; color:var(--text-dim); margin:4px 0 0;">Số phiên truy cập được tạo trong 7 ngày gần nhất</p>
            </div>
            <span id="chart-total-badge"
                  style="background:var(--accent,#4A90E2);color:#fff;padding:4px 14px;border-radius:20px;font-size:13px;font-weight:600;">
                0 lượt
            </span>
        </div>
        <div style="position:relative; height:260px;">
            <canvas id="daily-scans-chart"></canvas>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            if (window.AudioTravelling && AudioTravelling.Modules && AudioTravelling.Modules.initAdminDashboard) {
                AudioTravelling.Modules.initAdminDashboard();
            }
        });
    </script>
}
