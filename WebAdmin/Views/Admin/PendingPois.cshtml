@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Duyệt POI";
}

<!-- Admin: POI Approval -->
<div id="view-poi-approval" class="view-section active">
    <div class="section-header">
        <div>
            <h3 class="section-title">Duyệt POI</h3>
            <p class="section-subtitle">Xem và duyệt các POI đang chờ phê duyệt từ Owner</p>
        </div>
    </div>

    <div class="glass-card" style="padding:24px;">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>Mã POI</th>
                    <th>Tên POI</th>
                    <th>Chủ cửa hàng</th>
                    <th>Ngày gửi</th>
                    <th style="text-align:center;">Hành động</th>
                </tr>
            </thead>
            <tbody id="poi-approval-body">
                <!-- Injected by JS -->
            </tbody>
        </table>
    </div>

    <!-- Reject Modal -->
    <div id="modal-reject-poi" class="modal-overlay hidden">
        <div class="modal-card">
            <h3 style="font-size:18px; font-weight:700; margin-bottom:20px;">
                <i class="fa-solid fa-circle-xmark" style="color:#ef4444; margin-right:8px;"></i>Từ chối POI
            </h3>
            <div class="mb-4">
                <label class="form-label">Lý do từ chối</label>
                <textarea id="reject-reason" class="form-input" rows="4" placeholder="Nhập lý do từ chối..."></textarea>
            </div>
            <div style="display:flex; gap:12px; justify-content:flex-end;">
                <button class="btn-ghost" id="btn-cancel-reject">Hủy</button>
                <button class="btn-danger-ghost" id="btn-confirm-reject" style="padding:10px 20px;">
                    <i class="fa-solid fa-xmark"></i> Xác nhận từ chối
                </button>
            </div>
        </div>
    </div>

    <!-- POI Detail Modal -->
    <div id="modal-poi-detail" class="modal-overlay hidden">
        <div class="modal-card" style="max-width:700px; max-height:90vh; overflow-y:auto;">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:20px;">
                <h3 style="font-size:18px; font-weight:700; margin:0;">
                    <i class="fa-solid fa-map-pin" style="color:var(--accent); margin-right:8px;"></i>Chi tiết POI
                </h3>
                <button class="btn-ghost" id="btn-close-poi-detail" style="font-size:16px; padding:4px 10px;">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>

            <!-- Cover Image -->
            <div id="poi-detail-cover" style="margin-bottom:16px; text-align:center;"></div>

            <!-- Info Grid -->
            <div id="poi-detail-info" style="display:grid; grid-template-columns:1fr 1fr; gap:12px; font-size:13px; margin-bottom:16px;"></div>

            <!-- Description -->
            <div id="poi-detail-description-section" style="margin-bottom:16px;">
                <strong style="color:var(--text-dim); display:block; margin-bottom:4px;">Mô tả (Tiếng Việt)</strong>
                <p id="poi-detail-description" style="font-size:13px; line-height:1.6; margin:0; padding:12px; background:var(--card-bg); border-radius:8px;"></p>
            </div>

            <!-- Image Gallery -->
            <div id="poi-detail-gallery-section" style="margin-bottom:20px;">
                <strong style="color:var(--text-dim); display:block; margin-bottom:8px;">Hình ảnh</strong>
                <div id="poi-detail-gallery" style="display:flex; gap:8px; flex-wrap:wrap;"></div>
            </div>

            <!-- Action buttons (visible only for pending POIs) -->
            <div id="poi-detail-actions" style="display:flex; gap:12px; justify-content:flex-end; border-top:1px solid var(--border); padding-top:16px;"></div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            if (window.AudioTravelling && AudioTravelling.Modules && AudioTravelling.Modules.initPOIApproval) {
                AudioTravelling.Modules.initPOIApproval();
            }
        });
    </script>
}
