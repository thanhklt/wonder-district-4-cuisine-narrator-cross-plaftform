<!DOCTYPE html>
<html lang="vn" data-theme="light">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Audio Travelling — Owner Portal</title>
    <meta name="description"
          content="Audio Travelling Owner Portal - Quản lý POI của bạn">

    <!-- Portal Guard — MUST load first to redirect unauthorized users -->
    <script src="~/assets/js/common/core/portalGuard.js" data-portal="owner"></script>

    <!-- Design System - Owner CSS only (no auth.css, no admin.css) -->
    <link rel="stylesheet" href="~/assets/css/common/base.css">
    <link rel="stylesheet" href="~/assets/css/common/layout.css">
    <link rel="stylesheet" href="~/assets/css/admin/dashboard.css">
    <link rel="stylesheet" href="~/assets/css/common/misc.css">
    <link rel="stylesheet" href="~/assets/css/common/theme-light.css">
    <link rel="stylesheet" href="~/assets/css/owner/owner.css">

    <!-- FontAwesome 6 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

    <!-- Toastify -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/toastify-js/src/toastify.min.css">
    <script src="https://cdn.jsdelivr.net/npm/toastify-js"></script>
</head>

<body>

    <!-- ═══════════════════════════════════════
         OWNER DASHBOARD APP
         ═══════════════════════════════════════ -->
    <div id="dashboard-app" style="height:100vh;">

        <div style="display:flex; height:100vh; overflow:hidden;">

            <!-- ── SIDEBAR (Owner only) ── -->
            <aside class="sidebar" id="app-sidebar">
                <div class="sidebar-brand">
                    <div class="sidebar-brand-icon">
                        <i class="fa-solid fa-headphones"></i>
                    </div>
                    <div class="sidebar-brand-text">
                        Du Hí <span>Đó Đây</span>
                        <small>Owner Portal</small>
                    </div>
                </div>

                <nav class="sidebar-nav" id="sidebar-nav">
                    <a class="nav-link" href="/owner" data-path="/owner">
                        <i class="fa-solid fa-chart-pie"></i> Tổng quan
                    </a>
                    <a class="nav-link" href="/owner/pois" data-path="/owner/pois">
                        <i class="fa-solid fa-location-dot"></i> Quản lý POI
                    </a>
                    <a class="nav-link" href="/owner/pois/create" data-path="/owner/pois/create">
                        <i class="fa-solid fa-plus-circle"></i> Tạo POI
                    </a>
                    <a class="nav-link" href="/owner/pois/status" data-path="/owner/pois/status">
                        <i class="fa-solid fa-list-check"></i> Trạng thái POI
                    </a>
                </nav>

                <div class="sidebar-footer">
                    <div class="sidebar-user">
                        <img id="sidebar-avatar" src="https://i.pravatar.cc/150?img=11" alt="User"
                             class="sidebar-avatar">
                        <div class="sidebar-user-info">
                            <p id="sidebar-name" class="sidebar-user-name">Owner</p>
                            <button id="btn-logout" class="btn-signout">
                                <i class="fa-solid fa-arrow-right-from-bracket"></i> Đăng xuất
                            </button>
                        </div>
                    </div>
                </div>
            </aside>

            <!-- ── MAIN CONTENT ── -->
            <main class="main-area">
                <!-- Top Header Bar -->
                <header class="top-header">
                    <h2 id="header-title">Owner Portal</h2>
                    <div style="display:flex; align-items:center; gap:12px;">
                    </div>
                </header>

                <!-- Scrollable Content -->
                <div class="content-wrapper">
                    @RenderBody()
                </div>
            </main>
        </div>
    </div>

    <!-- ═══════════════════════════════════════
         SCRIPTS — Owner Portal only
         ═══════════════════════════════════════ -->

    <!-- 1. Config -->
    <script src="~/assets/js/common/config/roles.js" asp-append-version="true"></script>
    <script src="~/assets/js/common/config/routes.js" asp-append-version="true"></script>

    <!-- 2. Core -->
    <script src="~/assets/js/common/core/storage.js" asp-append-version="true"></script>
    <script src="~/assets/js/common/core/apiClient.js" asp-append-version="true"></script>
    <script src="~/assets/js/common/core/ui.js" asp-append-version="true"></script>
    <script src="~/assets/js/common/core/auth.js" asp-append-version="true"></script>
    <script src="~/assets/js/common/core/roleGuard.js" asp-append-version="true"></script>
    <script src="~/assets/js/common/core/router.js" asp-append-version="true"></script>

    <!-- 3. Services -->
    <script src="~/assets/js/common/services/poiService.js" asp-append-version="true"></script>
    <script src="~/assets/js/common/services/packageService.js" asp-append-version="true"></script>

    <!-- 4. Utils -->
    <script src="~/assets/js/common/utils/formatters.js" asp-append-version="true"></script>
    <script src="~/assets/js/common/utils/validators.js" asp-append-version="true"></script>

    <!-- 5. Owner Modules ONLY (no admin modules loaded) -->
    <script src="~/assets/js/owner/ownerDashboard.js" asp-append-version="true"></script>
    <script src="~/assets/js/owner/myPois.js" asp-append-version="true"></script>
    <script src="~/assets/js/owner/createPoi.js" asp-append-version="true"></script>
    <script src="~/assets/js/owner/poiStatus.js" asp-append-version="true"></script>

    <!-- 6. Owner App Bootstrap -->
    <script src="~/assets/js/owner/appOwner.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>
